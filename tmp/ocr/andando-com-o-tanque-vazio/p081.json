":0.32986845889007177,"y1":0.34701642023562695},{"y1":0.36354166666666665,"x0":0.12359550605030022,"y0":0.35029069774372634,"t":"deste mundo confuso ficam cada","c":1,"x1":0.40224719081917698},{"y1":0.38380991064643599,"c":1,"x0":0.14141371776561376,"t":"vez mais desconcertantes e.","x1":0.38673045951356411,"y0":0.36856349051786186},{"x0":0.13258427045760535,"t":"assim, a cada ano precisamos","x1":0.39325842661988669,"c":1,"y0":0.38802083319914427,"y1":0.40261627918970677},{"x1":0.37547309324877076,"y0":0.40539962443730193,"t":"buscar mais e mais a paz","y1":0.42002421060104367,"c":1,"x0":0.15477258412499906},{"y1":0.43906250013861547,"x1":0.36629213540119093,"y0":0.42441860451254732,"t":"e o conforto das alegres","x0":0.15955056193564862,"c":1},{"x0":0.19295094525977749,"t":"coisas simplesỊẠi","c":1,"y1":0.4573929819067355,"x1":0.33762721004795548,"y0":0.44177602138098104},{"y1":0.47819767418179071,"c":1,"t":"WOMEN'S HOME COMPANION.","x0":0.13483145919120959,"x1":0.39325842892355506,"y0":0.46510416666666665},{"x0":0.18402824678134544,"t":"Dezembro de 1935","x1":0.34412812357767075,"y0":0.48244670238007292,"c":1,"y1":0.49854548216082406},{"x0":0.4357605834013154,"y1":0.34850203359083665,"c":1,"t":"medo de pensar onde meu casamento","y0":0.32662407297422458,"x1":0.82945390178259704},{"y0":0.3515625,"c":1,"y1":0.36927083333333333,"x0":0.43595505515762978,"t":"poderia estar hoje se eu não tivesse","x1":0.79775280421590145},{"t":"aprendido essa lição.","c":1,"y0":0.37645348816910373,"x0":0.43595505502821569,"x1":0.65393258535507737,"y1":0.39389534900386125},{"x0":0.47172664860965857,"x1":0.84287894860315626,"y1":0.42356476388680986,"c":1,"t":"Aprenda o que enche e o que drena","y0":0.40355012192434958},{"x1":0.86741573039202557,"y0":0.42864583333333339,"c":1,"t":"seu tanque e o de seu cônjuge, e isso talvez","y1":0.44635416666666661,"x0":0.43370786532912342},{"y0":0.45203488370937894,"x0":0.4359550635721357,"t":"evite os muitos anos dormindo na casinha","x1":0.8629213477619595,"c":1,"y1":0.4682291666782179},{"x1":0.86741572873355521,"y0":0.4765625,"t":"do cachorro — sem mencionar a tensão em","x0":0.43595505554420838,"c":1,"y1":0.49127906965365664},{"x1":0.58876404567857754,"c":1,"t":"seu ministério.","x0":0.43370786564452579,"y0":0.50145348822192626,"y1":0.51614583348350007},{"c":1,"x1":0.37977528035460423,"x0":0.10561798040718444,"y0":0.54360465116462486,"y1":0.55959302293421209,"t":"LUZES DE ADVERTÊNCIA"},{"t":"Deixe-me adicionar um pequeno esclarecimento. Todos nós sabemos","y0":0.58281249999999996,"c":1,"x0":0.15280898913025234,"y1":0.60052083333333328,"x1":0.84269662826331437},{"c":1,"x0":0.1033707864110231,"t":"que haverá tensões em qualquer ocupação - seja no banco, no cuidado com","y0":0.60610465162484217,"y1":0.625,"x1":0.87191011287834463},{"x0":0.10337079250809268,"x1":0.824719089391037,"t":"as crianças ou na engenharia nuclear. Haverá aqueles inevitáveis pontos","y1":0.6484375,"y0":0.62916666666666665,"c":1},{"t":"de estresse dos quais você não conseguirá livrar-se. Ainda que as tensões","y1":0.67151162808829501,"x1":0.82696629107936237,"c":1,"x0":0.1033707864038725,"y0":0.65406976725353749},{"t":"terminem sendo enfrentadas e tratadas de modo apropriado, existem alguns","x1":0.87415730258617375,"x0":0.10337078796720624,"y1":0.69635416666666672,"c":1,"y0":0.67708333333333337},{"x1":0.86067415816948423,"t":"estressores com os quais você talvez tenha de conviver por um longo tempo","y0":0.70203488352992449,"y1":0.71947674436468201,"c":1,"x0":0.10337078805183388},{"y0":0.7252906978286654,"t":"antes de descobrir como resolvê-los.","x1":0.46966292000473209,"y1":0.74127906959825263,"c":1,"x0":0.10112359643873003},{"x0":0.14831460664535734,"y0":0.75416666666666665,"y1":0.77034883709085045,"x1":0.78202247240141587,"c":1,"t":"Todos nós estamos envolvidos num sem-número de atividades"},{"y1":0.79651162787974128,"c":1,"x1":0.8471910031695179,"x0":0.10337079074766614,"t":"diárias — algumas que escolhemos, outras que pessoas escolhem por nós.","y0":0.77760416631599516},{"t":"No trabalho, no ministério e na família é inevitável haver atividades","x0":0.10337078640372663,"x1":0.7977528095628269,"y0":0.80208333333333337,"y1":0.82135416666666672,"c":1},{"c":1,"y1":0.84447674315113241,"t":"que tendem a exauri-lo. É impossível evitar completamente as coisas que","x0":0.10112360140608728,"x1":0.84269661768260873,"y0":0.82267441909450711},{"t":"drenam sua energia. Todavia, ao garantir que seu tanque emocional","y0":0.85029069774372634,"y1":0.86927083333333333,"c":1,"x0":0.1011236004117053,"x1":0.79550560599393272},{"t":"esteja cheio até a boca, você não verá de repente uma luz de \"na reserva\"","c":1,"y0":0.87132694244777364,"x1":0.8474144155782567,"y1":0.89528229456608333,"x0":0.10092936686493363},{"c":1,"x0":0.10112359518239047,"t":"acendendo no seu painel de instrumentos interior.","y0":0.89947916666666672,"y1":0.91874999999999996,"x1":0.62471910069292558},{"y0":0.94912790684294657,"c":1,"x1":0.50561797691910415,"x0":0.46741573108089579,"t":"86","y1":0.96366279054077419}]